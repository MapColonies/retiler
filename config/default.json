{
  "openapiConfig": {},
  "telemetry": {
    "logger": {
      "level": "info",
      "prettyPrint": false
    },
    "metrics": {
      "enabled": true,
      "buckets": [0.1, 0.5, 1, 5, 15, 50, 250, 500]
    },
    "tracing": {
      "isEnabled": false
    },
    "shared": {}
  },
  "server": {
    "port": 8080
  },
  "app": {
    "project": {
      "name": "default",
      "stateUrl": "defaultStateUrl"
    },
    "forceProcess": false,
    "queueName": "QUEUE_NAME",
    "parallelism": 5,
    "jobQueue": {
      "waitTimeout": 5000,
      "pgBoss": {
        "host": "localhost",
        "port": 5432,
        "username": "postgres",
        "password": "postgres",
        "schema": "pgboss",
        "ssl": {
          "enabled": false,
          "ca": "",
          "key": "",
          "cert": ""
        },
        "database": "postgres",
        "supervisor": true,
        "healthCheckTimeoutMs": 5000
      }
    }
  },
  "detiler": {
    "enabled": false,
    "proceedOnFailure": true
  }
}
